---
import { contacts } from '../../config/content';
---

<section id="contacts" class="contacts-section">
  <div class="site-container">
    <div class="contacts-shell">
      <div class="contacts-content">
        <div class="section-kicker">Следующий шаг</div>
        <h2>
          Разберём, где процесс можно сделать быстрее и надёжнее
        </h2>
        <p class="contacts-lead">
          На первой встрече не нужно техническое задание. Достаточно описать, что команда делает вручную, где теряются заявки или какие вопросы повторяются каждый день.
        </p>

        <div class="contact-links">
          <a href={contacts.telegram} target="_blank" rel="noopener noreferrer"><span>Telegram</span><span>↗</span></a>
          <a href={contacts.max} target="_blank" rel="noopener noreferrer"><span>MAX</span><span>↗</span></a>
          <a href={contacts.vk} target="_blank" rel="noopener noreferrer"><span>VK</span><span>↗</span></a>
          <a href={contacts.instagram} target="_blank" rel="noopener noreferrer"><span>Instagram</span><span>↗</span></a>
          <a href={`tel:${contacts.phone.replace(/[^+\d]/g, '')}`}><span>{contacts.phone}</span><span>↗</span></a>
        </div>

        <p class="contact-note">Обычно начинаем с 20–30 минут разговора о процессе.</p>
      </div>

      <div class="callback-wrap">
        <form id="callback-form" class="callback-form" novalidate>
          <div class="form-heading">
            <div>Заказать обратный звонок</div>
            <p>Оставьте номер и пару слов о задаче.</p>
          </div>

          <input type="text" name="company" tabindex="-1" aria-hidden="true" class="absolute -z-10 h-0 w-0 opacity-0" autocomplete="off" />

          <div class="form-field">
            <label for="name">Имя</label>
            <input type="text" id="name" name="name" autocomplete="name" placeholder="Как к вам обращаться?" />
          </div>

          <div class="form-field">
            <label for="phone">Телефон <span>*</span></label>
            <input type="tel" id="phone" name="phone" inputmode="numeric" autocomplete="tel" pattern="[0-9]*" required placeholder="Например, 9828154779" aria-describedby="phone-hint" />
            <span id="phone-hint" class="sr-only">Введите 10 или 11 цифр российского номера</span>
          </div>

          <div class="form-field">
            <label for="message">Что хотите улучшить?</label>
            <textarea id="message" name="message" rows="3" placeholder="Например: не успеваем обрабатывать заявки"></textarea>
          </div>

          <button type="submit" class="button-base button-primary form-submit">
            <span>Жду звонка</span>
            <span aria-hidden="true">↗</span>
          </button>

          <div id="form-status" class="hidden form-status" role="status" aria-live="polite"></div>
          <p class="form-privacy">
            Контакты используются только для связи по вашему запросу.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('callback-form') as HTMLFormElement | null;
    const statusDiv = document.getElementById('form-status');
    const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const phoneInput = document.getElementById('phone') as HTMLInputElement | null;

    if (!form || !statusDiv || !submitBtn || !phoneInput) return;

    phoneInput.addEventListener('input', () => {
      phoneInput.value = phoneInput.value.replace(/\D/g, '').slice(0, 11);
    });

    const showStatus = (message: string, isSuccess: boolean) => {
      statusDiv.textContent = message;
      statusDiv.className = `form-status ${isSuccess ? 'is-success' : 'is-error'}`;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(form);
      const company = formData.get('company');
      const rawPhone = String(formData.get('phone') || '');

      if (company) {
        showStatus('Контакты отправлены. Я свяжусь с вами.', true);
        form.reset();
        return;
      }

      const digits = rawPhone.replace(/\D/g, '');
      let normalizedPhone = '';

      if (digits.length === 10) normalizedPhone = `+7${digits}`;
      if (digits.length === 11 && digits.startsWith('8')) normalizedPhone = `+7${digits.slice(1)}`;
      if (digits.length === 11 && digits.startsWith('7')) normalizedPhone = `+${digits}`;

      if (!normalizedPhone) {
        showStatus('Введите российский номер полностью: 10 или 11 цифр.', false);
        phoneInput.focus();
        return;
      }

      const label = submitBtn.querySelector('span');
      if (label) label.textContent = 'Отправляю...';
      submitBtn.disabled = true;
      statusDiv.classList.add('hidden');

      try {
        const response = await fetch('/api/callback', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: formData.get('name'),
            phone: normalizedPhone,
            message: formData.get('message'),
            source: window.location.hostname,
            page: window.location.href
          })
        });

        if (!response.ok) throw new Error('Request failed');
        showStatus('Спасибо. Контакты отправлены — я свяжусь с вами.', true);
        form.reset();
      } catch {
        showStatus('Не удалось отправить. Напишите мне в Telegram или MAX.', false);
      } finally {
        submitBtn.disabled = false;
        if (label) label.textContent = 'Жду звонка';
      }
    });
  });
</script>
