---
import { faq } from '../../config/content';
---

<section class="section-space faq-section">
  <div class="site-container faq-grid">
    <div class="faq-intro">
      <div class="section-kicker">FAQ</div>
      <h2 class="section-title">Перед первой встречей</h2>
      <p>
        Если вашего вопроса здесь нет, напишите его в Telegram или MAX — отвечу по существу.
      </p>
    </div>

    <div class="faq-list">
      {faq.map((item) => (
        <details class="faq-item">
          <summary>
            <span>{item.question}</span>
            <span class="faq-plus" aria-hidden="true">+</span>
          </summary>
          <div class="faq-answer">{item.answer}</div>
        </details>
      ))}
    </div>
  </div>
</section>
