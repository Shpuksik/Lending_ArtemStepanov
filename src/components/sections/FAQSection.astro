---
import { faq } from '../../config/content';
---

<section class="section-space pt-6 md:pt-10">
  <div class="site-container grid gap-10 lg:grid-cols-[0.62fr_1.38fr] lg:gap-20">
    <div data-reveal>
      <div class="section-kicker">FAQ</div>
      <h2 class="section-title">Перед первой встречей</h2>
      <p class="mt-5 max-w-sm text-sm leading-[1.7] text-text-muted">
        Если вашего вопроса здесь нет, напишите его в Telegram или MAX — отвечу без обязательств и продажи «в лоб».
      </p>
    </div>

    <div class="faq-list" data-reveal-group>
      {faq.map((item, index) => (
        <details class="faq-item group" data-reveal-item>
          <summary>
            <span class="mr-4 text-xs font-semibold text-accent">0{index + 1}</span>
            <span class="flex-1">{item.question}</span>
            <span class="faq-plus" aria-hidden="true">+</span>
          </summary>
          <div class="faq-answer">{item.answer}</div>
        </details>
      ))}
    </div>
  </div>
</section>
