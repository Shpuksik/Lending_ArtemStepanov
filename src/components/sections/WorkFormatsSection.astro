---
import Button from '../ui/Button.astro';
import { workFormats } from '../../config/content';
---

<section id="formats" class="section-space formats-section">
  <div class="site-container">
    <div class="section-heading split-heading">
      <div>
        <div class="section-kicker">Форматы работы</div>
        <h2 class="section-title">С чего можно начать</h2>
      </div>
      <p class="section-lead">
        Можно выбрать одну понятную задачу, проверить решение в реальной работе и затем решить, стоит ли расширять автоматизацию.
      </p>
    </div>

    <div class="formats-grid">
      {workFormats.map((format) => (
        <article class={`format-column ${format.accent ? 'format-column-accent' : ''}`}>
          <div class="format-meta">
            <span>{format.number}</span>
            {format.accent && <span class="recommended-label">Рекомендуемый старт</span>}
          </div>
          <h3>{format.title}</h3>
          <p>{format.description}</p>
          <div class="format-audience">
            {format.audience}
          </div>
          <Button href="#contacts" variant={format.accent ? 'primary' : 'ghost'}>
            {format.accent ? 'Обсудить процесс' : 'Узнать подробнее'}
          </Button>
        </article>
      ))}
    </div>
  </div>
</section>
