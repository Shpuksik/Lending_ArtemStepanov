---
import Button from '../ui/Button.astro';
import { workFormats } from '../../config/content';
---

<section id="formats" class="section-space">
  <div class="site-container">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between" data-reveal>
      <div class="section-intro mb-0">
        <div class="section-kicker">Форматы работы</div>
        <h2 class="section-title">С чего можно начать</h2>
      </div>
      <p class="max-w-md text-sm leading-[1.7] text-text-muted lg:pb-2">
        Можно выбрать одну понятную задачу, проверить решение в реальной работе и затем решить, стоит ли расширять автоматизацию.
      </p>
    </div>

    <div class="mt-12 grid gap-4 lg:grid-cols-3" data-reveal-group>
      {workFormats.map((format) => (
        <article class={`format-card ${format.accent ? 'format-card-accent' : ''}`} data-reveal-item>
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold tracking-[0.18em] text-accent">{format.number}</span>
            {format.accent && <span class="recommended-label">Лучший старт</span>}
          </div>
          <h3 class="mt-10 font-display text-[24px] font-medium text-text-main">{format.title}</h3>
          <p class="mt-4 text-sm leading-[1.7] text-text-secondary">{format.description}</p>
          <div class="mt-7 border-t border-border/60 pt-5 text-xs leading-[1.7] text-text-muted">
            {format.audience}
          </div>
          <Button href="#contacts" variant={format.accent ? 'primary' : 'ghost'} class="mt-8 w-full">
            {format.accent ? 'Обсудить процесс' : 'Узнать подробнее'}
          </Button>
        </article>
      ))}
    </div>
  </div>
</section>
