---
import { cases } from '../../config/content';

const featuredCases = cases.filter((item) => item.featured);
const compactCases = cases.filter((item) => !item.featured);
---

<section id="cases" class="section-space cases-section">
  <div class="site-container">
    <div class="section-heading split-heading cases-heading">
      <div>
        <div class="section-kicker">Избранные проекты</div>
        <h2 class="section-title">Реальные задачи.<br />Рабочие решения.</h2>
      </div>
      <p class="section-lead">
        Без выдуманных процентов и демонстрационных прототипов. Что мешало работе, как устроено решение и что изменилось после запуска.
      </p>
    </div>

    <div class="case-list">
      {featuredCases.map((item, index) => (
        <article class="case-study">
          <header class="case-header">
            <div class="case-index">0{index + 1}</div>
            <div class="case-title-block">
              <div class="case-category">{item.category}</div>
              <h3>{item.title}</h3>
            </div>
            <p class="case-summary">{item.summary}</p>
          </header>

          <div class="case-body">
            <div class="case-path-block">
              <span class="case-label">Контур решения</span>
              <ol class="case-path">
                {item.flow?.map((node, flowIndex) => (
                  <li>
                    <span>0{flowIndex + 1}</span>
                    {node}
                  </li>
                ))}
              </ol>
            </div>

            <dl class="case-details">
              <div>
                <dt>Задача</dt>
                <dd>{item.problem}</dd>
              </div>
              <div>
                <dt>Решение</dt>
                <dd>{item.solution}</dd>
              </div>
              <div class="case-result">
                <dt>Что изменилось</dt>
                <dd>{item.result}</dd>
              </div>
            </dl>
          </div>

          {item.links && (
            <div class="case-links">
              {item.links.map((link) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label}<span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>

    <div class="compact-cases">
      {compactCases.map((item, index) => (
        <article class="compact-case">
          <span class="compact-index">0{featuredCases.length + index + 1}</span>
          <div>
            <div class="case-category">{item.category}</div>
            <h3>{item.title}</h3>
          </div>
          <div class="compact-copy">
            <p>{item.summary}</p>
            <p><strong>Результат:</strong> {item.result}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
