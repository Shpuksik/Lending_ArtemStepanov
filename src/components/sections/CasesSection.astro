---
import { cases } from '../../config/content';

const featuredCases = cases.filter((item) => item.featured);
const compactCases = cases.filter((item) => !item.featured);
---

<section id="cases" class="section-space border-y border-border/60 bg-surface/45">
  <div class="site-container">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between" data-reveal>
      <div class="section-intro mb-0">
        <div class="section-kicker">Реализованные проекты</div>
        <h2 class="section-title">Что уже работает на практике</h2>
      </div>
      <p class="max-w-md text-sm leading-[1.7] text-text-muted lg:pb-2">
        Здесь — реальные задачи: что мешало работе, как устроено решение и что изменилось после запуска.
      </p>
    </div>

    <div class="mt-14 space-y-5" data-reveal-group>
      {featuredCases.map((item, index) => (
        <article class="case-study" data-reveal-item>
          <div class={`case-visual ${index % 2 === 1 ? 'lg:order-2' : ''}`}>
            <div class="case-visual-grid" aria-hidden="true"></div>
            <div class="relative z-10 flex h-full flex-col">
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-accent">Схема процесса</span>
                <span class="case-index">0{index + 1}</span>
              </div>

              <div class="my-auto py-10">
                <div class="case-flow">
                  {item.flow?.map((node, flowIndex) => (
                    <>
                      <div class={`case-flow-node ${flowIndex === 1 ? 'case-flow-node-core' : ''}`}>
                        {flowIndex === 1 && <span class="case-flow-pulse" aria-hidden="true"></span>}
                        <span class="relative z-10">{node}</span>
                      </div>
                      {flowIndex < (item.flow?.length || 0) - 1 && (
                        <div class="case-flow-line" aria-hidden="true"><span></span></div>
                      )}
                    </>
                  ))}
                </div>
              </div>

              <div class="flex items-center gap-2 text-[11px] text-text-muted">
                <span class="h-1.5 w-1.5 rounded-full bg-[#65d8a7] shadow-[0_0_10px_rgba(101,216,167,0.7)]"></span>
                Рабочий сценарий
              </div>
            </div>
          </div>

          <div class={`case-content ${index % 2 === 1 ? 'lg:order-1' : ''}`}>
            <div class="text-[11px] font-semibold uppercase tracking-[0.16em] text-accent">{item.category}</div>
            <h3 class="mt-4 font-display text-[28px] font-medium leading-tight tracking-tight text-text-main sm:text-[34px]">{item.title}</h3>
            <p class="mt-5 text-[16px] leading-[1.7] text-text-secondary">{item.summary}</p>

            <dl class="mt-7 space-y-4 border-t border-border/60 pt-6">
              <div class="case-detail">
                <dt>Задача</dt>
                <dd>{item.problem}</dd>
              </div>
              <div class="case-detail">
                <dt>Система</dt>
                <dd>{item.solution}</dd>
              </div>
              <div class="case-detail case-detail-result">
                <dt>Эффект</dt>
                <dd>{item.result}</dd>
              </div>
            </dl>

            {item.links && (
              <div class="mt-7 flex flex-wrap gap-3">
                {item.links.map((link) => (
                  <a href={link.href} target="_blank" rel="noopener noreferrer" class="case-link">
                    {link.label}<span aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>

    <div class="mt-5 grid gap-5 md:grid-cols-2" data-reveal-group>
      {compactCases.map((item, index) => (
        <article class="compact-case" data-reveal-item>
          <div class="flex items-start justify-between gap-4">
            <span class="text-[10px] font-semibold uppercase tracking-[0.16em] text-accent">{item.category}</span>
            <span class="case-index">0{featuredCases.length + index + 1}</span>
          </div>
          <h3 class="mt-8 max-w-md font-display text-[23px] font-medium leading-tight text-text-main">{item.title}</h3>
          <p class="mt-4 text-sm leading-[1.7] text-text-secondary">{item.summary}</p>
          <div class="mt-7 border-t border-border/60 pt-5 text-sm leading-[1.7] text-text-main">
            <span class="mr-2 text-accent">Эффект</span>{item.result}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
