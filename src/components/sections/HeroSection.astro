---
import Button from '../ui/Button.astro';
import { hero, proofPoints } from '../../config/content';
---

<section id="top" class="hero-section">
  <div class="site-container hero-layout">
    <div class="hero-copy">
      <p class="hero-overline">AI-автоматизация для бизнеса</p>

      <h1>
        <span class="block">{hero.h1}</span>
        <span class="hero-title-accent">{hero.h1Accent}</span>
      </h1>

      <p class="hero-subtitle">
        {hero.subtitle}
      </p>

      <div class="hero-actions">
        <Button href="#contacts" variant="primary">
          Обсудить задачу <span aria-hidden="true">↗</span>
        </Button>
        <Button href="#cases" variant="ghost">
          Посмотреть кейсы
        </Button>
      </div>

      <div class="hero-scope" aria-label="Направления работы">
        {hero.scope.map((item) => <span>{item}</span>)}
      </div>
    </div>

    <figure class="hero-portrait">
      <div class="hero-image-wrap">
        <img
          src="/images/artem-stepanov-about-4x5-gradient.webp"
          alt="Артём Момот — инженер AI-автоматизации"
          width="896"
          height="1120"
          fetchpriority="high"
          decoding="async"
        />
        <div class="hero-experience">
          <strong>15</strong>
          <span>лет инженерного<br />опыта</span>
        </div>
      </div>
      <figcaption>
        <span>Артём Момот</span>
        <span>Ижевск / удалённо</span>
      </figcaption>
    </figure>
  </div>

  <div class="site-container">
    <div class="proof-strip">
      {proofPoints.map((point) => (
        <div class="proof-item">
          <strong>{point.value}</strong>
          <span>{point.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
