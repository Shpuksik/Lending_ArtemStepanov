---
import { automationAreas } from '../../config/content';
---

<section id="expertise" class="section-space">
  <div class="site-container">
    <div class="section-intro" data-reveal>
      <div class="section-kicker">Что беру под контроль</div>
      <h2 class="section-title">Не отдельный бот, а работающий участок процесса</h2>
      <p class="section-lead">
        Автоматизация приносит пользу, когда связана с реальной операционкой: получает данные, действует по правилам и возвращает понятный результат сотруднику или руководителю.
      </p>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-2" data-reveal-group>
      {automationAreas.map((area) => (
        <article class="expertise-card group" data-reveal-item>
          <div class="flex items-start justify-between gap-5">
            <span class="text-xs font-semibold tracking-[0.18em] text-accent">{area.number}</span>
            <div class="expertise-arrow" aria-hidden="true">↗</div>
          </div>
          <h3 class="mt-8 font-display text-[24px] font-medium tracking-tight text-text-main sm:text-[28px]">{area.title}</h3>
          <p class="mt-4 max-w-xl text-[15px] leading-[1.7] text-text-secondary">{area.description}</p>
          <div class="mt-7 flex flex-wrap gap-2">
            {area.items.map((item) => <span class="mini-chip">{item}</span>)}
          </div>
          <div class="mt-7 border-t border-border/60 pt-5 text-sm leading-relaxed text-text-main">
            <span class="mr-2 text-accent">Результат</span>{area.effect}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
