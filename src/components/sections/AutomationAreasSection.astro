---
import { automationAreas } from '../../config/content';
---

<section id="expertise" class="section-space expertise-section">
  <div class="site-container">
    <div class="section-heading split-heading">
      <div>
        <div class="section-kicker">Возможности</div>
        <h2 class="section-title">Что можно<br />автоматизировать</h2>
      </div>
      <p class="section-lead">
        От обработки заявок до поиска по внутренним документам. Решение встраивается в текущую работу команды и связывается с сервисами, которыми вы уже пользуетесь.
      </p>
    </div>

    <div class="expertise-list">
      {automationAreas.map((area) => (
        <article class="expertise-row">
          <div class="expertise-name">
            <span class="row-number">{area.number}</span>
            <h3>{area.title}</h3>
          </div>
          <p class="expertise-description">{area.description}</p>
          <div class="expertise-result">
            <span>Результат</span>
            <p>{area.effect}</p>
            <ul aria-label="Примеры решений">
              {area.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
