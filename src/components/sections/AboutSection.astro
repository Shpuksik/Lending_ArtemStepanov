---
import { about } from '../../config/content';
---

<section id="about" class="section-space border-y border-border/60 bg-surface/45">
  <div class="site-container">
    <div class="max-w-[920px]" data-reveal-group>
      <div data-reveal-item class="section-kicker">{about.eyebrow}</div>
      <h2 data-reveal-item class="section-title max-w-[760px]">{about.title}</h2>
      <div data-reveal-item class="mt-7 max-w-[720px] space-y-5 text-[16px] leading-[1.8] text-text-secondary">
        {about.text.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div class="mt-9 grid gap-3" data-reveal-item>
        {about.principles.map((principle) => (
          <div class="principle-row">
            <span class="principle-check" aria-hidden="true">✓</span>
            <span>{principle}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
