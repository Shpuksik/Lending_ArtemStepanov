---
import { about } from '../../config/content';
---

<section id="about" class="section-space about-section">
  <div class="site-container">
    <div class="about-topline">
      <span>{about.eyebrow}</span>
      <span>Инженерный опыт / IT / бизнес-процессы</span>
    </div>

    <div class="about-grid">
      <div class="about-statement">
        <span class="about-number">15</span>
        <p>лет работал инженером-технологом в нефтегазовой отрасли</p>
      </div>

      <div class="about-content">
        <h2>{about.title}</h2>
        <div class="about-copy">
          {about.text.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>

    <div class="principles-list">
      {about.principles.map((principle, index) => (
        <div class="principle-row">
          <span>0{index + 1}</span>
          <strong>{principle}</strong>
        </div>
      ))}
    </div>
  </div>
</section>
