---
import { about } from '../../config/content';
---

<section id="about" class="section-space border-y border-border/60 bg-surface/45">
  <div class="site-container grid items-center gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:gap-20">
    <div class="relative mx-auto w-full max-w-[470px] lg:mx-0" data-reveal>
      <div class="portrait-frame">
        <div class="portrait-lines" aria-hidden="true"></div>
        <img
          src="/images/artem-stepanov-about-4x5-gradient.webp"
          alt="Артём Момот — инженер AI-автоматизации"
          width="896"
          height="1120"
          loading="lazy"
          decoding="async"
          class="relative z-10 h-full w-full object-cover"
        />
      </div>
      <div class="portrait-badge">
        <span class="font-display text-[28px] font-semibold text-text-main">15</span>
        <span class="text-[11px] leading-tight text-text-muted">лет работы<br />со сложными процессами</span>
      </div>
    </div>

    <div data-reveal-group>
      <div data-reveal-item class="section-kicker">{about.eyebrow}</div>
      <h2 data-reveal-item class="section-title max-w-[760px]">{about.title}</h2>
      <div data-reveal-item class="mt-7 max-w-[720px] space-y-5 text-[16px] leading-[1.8] text-text-secondary">
        {about.text.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div class="mt-9 grid gap-3" data-reveal-item>
        {about.principles.map((principle) => (
          <div class="principle-row">
            <span class="principle-check" aria-hidden="true">✓</span>
            <span>{principle}</span>
          </div>
        ))}
      </div>

      <div data-reveal-item class="mt-9 flex items-center gap-4 border-t border-border/60 pt-7">
        <div class="brand-monogram">AM</div>
        <div>
          <div class="font-display text-base font-medium text-text-main">Артём Момот</div>
          <div class="text-xs text-text-muted">Инженер AI-автоматизации · Ижевск / удалённо</div>
        </div>
      </div>
    </div>
  </div>
</section>
