---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  class?: string;
}

const { href, variant = 'primary', class: className = '' } = Astro.props;
const baseStyles = 'button-base';
const variants = {
  primary: 'button-primary',
  secondary: 'button-secondary',
  ghost: 'button-ghost'
};
const Element = href ? 'a' : 'button';
---

<Element href={href} class={`${baseStyles} ${variants[variant]} ${className}`}>
  <slot />
</Element>
