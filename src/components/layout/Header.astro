---
import Button from '../ui/Button.astro';
---

<header class="site-header">
  <div class="site-container header-inner">
    <a href="#top" class="brand-mark" aria-label="Артём Момот — на главную">
      <span class="brand-monogram" aria-hidden="true">AM</span>
      <span class="brand-copy">
        <strong>Артём Момот</strong>
        <small>инженер AI-автоматизации</small>
      </span>
    </a>

    <nav class="header-nav" aria-label="Основная навигация">
      <a class="nav-link" href="#cases">Кейсы</a>
      <a class="nav-link" href="#expertise">Возможности</a>
      <a class="nav-link" href="#process">Подход</a>
      <a class="nav-link" href="#about">Обо мне</a>
    </nav>

    <div class="header-actions">
      <Button href="#contacts" variant="ghost" class="header-contact-button">
        Контакты
      </Button>
      <Button href="#contacts" variant="primary" class="header-discuss-button">
        Обсудить задачу
      </Button>
    </div>
  </div>
</header>
