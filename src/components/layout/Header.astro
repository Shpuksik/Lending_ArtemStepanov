---
import Button from '../ui/Button.astro';
---

<header class="site-header">
  <div class="site-container flex min-h-[72px] flex-wrap items-center justify-between gap-x-2 gap-y-2.5 py-3 sm:h-[72px] sm:flex-nowrap sm:gap-5 sm:py-0">
    <a href="#top" class="brand-mark" aria-label="Артём Момот — на главную">
      <span class="brand-monogram hidden sm:inline-flex">AM</span>
      <span class="block min-w-0">
        <span class="block whitespace-nowrap font-display text-[15px] font-semibold leading-tight text-text-main sm:text-[18px]">Артём Момот</span>
        <span class="block whitespace-nowrap text-[9px] leading-tight text-text-muted sm:text-[11px]">инженер AI-автоматизации</span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-7" aria-label="Основная навигация">
      <a class="nav-link" href="#expertise">Возможности</a>
      <a class="nav-link" href="#cases">Кейсы</a>
      <a class="nav-link" href="#process">Подход</a>
      <a class="nav-link" href="#about">Обо мне</a>
    </nav>

    <div class="flex w-full shrink-0 items-center gap-2 sm:w-auto">
      <Button href="#contacts" variant="ghost" class="min-h-[42px] flex-1 px-3 text-[12px] sm:flex-none sm:px-4 sm:text-[13px]">
        Контакты
      </Button>
      <Button href="#contacts" variant="secondary" class="min-h-[42px] flex-1 px-3 text-[12px] sm:flex-none sm:px-5 sm:text-[13px]">
        Обсудить задачу
      </Button>
    </div>
  </div>
</header>
