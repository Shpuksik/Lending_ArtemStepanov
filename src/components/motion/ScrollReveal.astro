<script is:inline>
  document.documentElement.classList.add('motion-ready');
</script>

<script>
  function initReveal() {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const singleItems = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
    const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal-group]'));

    if (reduceMotion || !('IntersectionObserver' in window)) {
      [...singleItems, ...groups.flatMap((group) => Array.from(group.querySelectorAll<HTMLElement>('[data-reveal-item]')))]
        .forEach((element) => element.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const target = entry.target as HTMLElement;

        if (target.hasAttribute('data-reveal-group')) {
          const children = target.querySelectorAll<HTMLElement>('[data-reveal-item]');
          children.forEach((child, index) => {
            child.style.transitionDelay = `${Math.min(index * 55, 275)}ms`;
            child.classList.add('is-visible');
          });
        } else {
          target.classList.add('is-visible');
        }

        observer.unobserve(target);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -7% 0px' });

    singleItems.forEach((element) => observer.observe(element));
    groups.forEach((group) => observer.observe(group));
  }

  document.addEventListener('DOMContentLoaded', initReveal, { once: true });
</script>
